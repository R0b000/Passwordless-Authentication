@namespace Auth.UI.Components.Layout
@inherits LayoutComponentBase
@using global::Shared.UI.Components.Menu
@using global::Shared.UI.Components.Icons
@using global::Auth.Model.Token
@using global::Auth.UI.Manager.Interface.Auth
@using Auth.Model.Models.Account

<div class="main-layout">
    <header class="layout-header">
        <h1 class="page-title">@Title</h1>
        <div class="account-menu-container">
            <div class="account-avatar" @onclick="ToggleAccountMenu">
                @AccountInitial
            </div>
            @if (AccountMenuOpen)
            {
                <div class="account-dropdown">
                    <shared-menu Items="MenuItems" OnAction="OnMenuAction" />
                </div>
            }
        </div>
    </header>

    <main class="layout-content">
        @Body
    </main>
</div>
