@page "/"
@page "/login"
@namespace Auth.UI.Components.Pages.Shared.Auth.Login
@using global::Auth.UI.Components.Pages.Shared.Auth.Passkey
@using global::Auth.UI.Components.Pages.Shared.Auth.Login
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@using global::Shared.UI.Components.Toaster
@using global::Shared.UI.Components.Modal

<PageTitle>Log in - Passwordless Auth</PageTitle>

<Toaster />

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-green-50 to-emerald-100 p-4">
    <div class="w-[85vw] h-[80vh] max-w-[1100px] min-h-[550px] bg-white rounded-3xl shadow-2xl grid grid-cols-1 md:grid-cols-2 overflow-hidden">
        
        <!-- Left Panel: Form Content -->
        <section class="bg-white flex flex-col justify-center px-8 md:px-12 py-8 overflow-y-auto relative z-10">
            <div class="w-full max-w-[360px] mx-auto">

                <!-- Tabs -->
                <ul class="flex gap-1 p-1 bg-gray-100 rounded-full mb-5" role="tablist">
                    <li class="list-none flex-1">
                        <button class="w-full py-1.5 rounded-full font-semibold text-xs transition-all @(Mode == "login" ? "bg-white text-emerald-900 shadow" : "text-gray-500 hover:text-gray-900")" 
                                @onclick="@(() => Mode = "login")" type="button">Log in</button>
                    </li>
                    <li class="list-none flex-1">
                        <button class="w-full py-1.5 rounded-full font-semibold text-xs transition-all @(Mode == "register" ? "bg-white text-emerald-900 shadow" : "text-gray-500 hover:text-gray-900")" 
                                @onclick="@(() => Mode = "register")" type="button">Create account</button>
                    </li>
                </ul>

                @if (Mode == "login")
                {
                    <h1 class="text-xl md:text-2xl font-extrabold text-emerald-950 mb-1 tracking-tight">Log in</h1>
                    <p class="text-xs text-gray-500 mb-4">Welcome back. Sign in to continue to your account.</p>

                    <!-- Social logins -->
                    <div class="grid grid-cols-3 gap-3 mb-4">
                        <button class="inline-flex items-center justify-center h-10 border border-gray-200 rounded-xl bg-white hover:border-emerald-600 transition-colors shadow-sm" type="button" @onclick="@(() => SocialAsync("Google"))" aria-label="Continue with Google">
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z" />
                                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.65l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z" />
                                <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84Z" />
                                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38Z" />
                            </svg>
                        </button>
                        <button class="inline-flex items-center justify-center h-10 border border-gray-200 rounded-xl bg-white hover:border-emerald-600 transition-colors shadow-sm" type="button" @onclick="@(() => SocialAsync("Microsoft"))" aria-label="Continue with Microsoft">
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                <path fill="#F25022" d="M2 2h9v9H2z" />
                                <path fill="#7FBA00" d="M13 2h9v9h-9z" />
                                <path fill="#00A4EF" d="M2 13h9v9H2z" />
                                <path fill="#FFB900" d="M13 13h9v9h-9z" />
                            </svg>
                        </button>
                        <button class="inline-flex items-center justify-center h-10 border border-transparent rounded-xl bg-gradient-to-br from-emerald-600 to-emerald-800 text-white hover:brightness-105 transition-all shadow-sm" type="button" @onclick="@OpenPasskeyModal" aria-label="Continue with a passkey">
                            <Icon Name="fingerprint" Size="Icon.IconSize.Small" />
                        </button>
                    </div>

                    <!-- Divider -->
                    <div class="flex items-center text-center text-xs text-gray-400 my-4 before:content-[''] before:flex-1 before:h-[1px] before:bg-gray-200 before:mr-3 after:content-[''] after:flex-1 after:h-[1px] after:bg-gray-200 after:ml-3">
                        <span>or log in with</span>
                    </div>

                    <EditForm Model="@LoginModel" OnValidSubmit="@LoginAsync" FormName="login">
                        <div class="mb-3.5">
                            <label class="block text-xs font-semibold text-gray-700 mb-1" for="login-id">Email</label>
                            <div class="flex items-center gap-2 border border-gray-200 rounded-xl px-3 bg-white focus-within:border-emerald-600 focus-within:ring-2 focus-within:ring-emerald-100 transition-all">
                                <span class="text-gray-400"><Icon Name="user" Size="Icon.IconSize.Small" /></span>
                                <InputText id="login-id" class="flex-1 py-2 text-sm outline-none bg-transparent text-gray-900 placeholder-gray-300" @bind-Value="LoginModel.Email" placeholder="you@example.com" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="block text-xs font-semibold text-gray-700 mb-1" for="login-pw">Password</label>
                            <div class="flex items-center gap-2 border border-gray-200 rounded-xl px-3 bg-white focus-within:border-emerald-600 focus-within:ring-2 focus-within:ring-emerald-100 transition-all">
                                <span class="text-gray-400"><Icon Name="lock" Size="Icon.IconSize.Small" /></span>
                                <InputText id="login-pw" type="@(ShowPassword ? "text" : "password")" class="flex-1 py-2 text-sm outline-none bg-transparent text-gray-900 placeholder-gray-300" @bind-Value="LoginModel.Password" placeholder="Your password" />
                                <button type="button" class="text-gray-400 hover:text-emerald-700 p-1" @onclick="@TogglePassword" aria-label="Toggle password visibility">
                                    <Icon Name="@(ShowPassword ? "eye-off" : "eye")" Size="Icon.IconSize.Small" />
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="w-full py-2 bg-emerald-800 hover:bg-emerald-900 text-white rounded-xl font-bold text-sm shadow-md hover:shadow-lg transition-all active:scale-[0.99]">Log in</button>
                    </EditForm>

                    <div class="text-center mt-4">
                        <a class="text-xs text-emerald-700 font-semibold hover:underline" href="#" @onclick="@(() => SocialAsync("reset"))" @onclick:preventDefault>Forgot login or password?</a>
                    </div>
                }
                else
                {
                    <h1 class="text-xl md:text-2xl font-extrabold text-emerald-950 mb-1 tracking-tight">Create account</h1>
                    <p class="text-xs text-gray-500 mb-4">Pick a username and password, then add a passkey for fast, passwordless sign-in.</p>

                    <EditForm Model="@RegisterModel" OnValidSubmit="@RegisterAsync" FormName="register">
                        <div class="mb-3">
                            <label class="block text-xs font-semibold text-gray-700 mb-1" for="reg-user">Username</label>
                            <div class="flex items-center gap-2 border border-gray-200 rounded-xl px-3 bg-white focus-within:border-emerald-600 focus-within:ring-2 focus-within:ring-emerald-100 transition-all">
                                <span class="text-gray-400"><Icon Name="user" Size="Icon.IconSize.Small" /></span>
                                <InputText id="reg-user" class="flex-1 py-2 text-sm outline-none bg-transparent text-gray-900 placeholder-gray-300" @bind-Value="RegisterModel.Username" placeholder="Choose a username" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="block text-xs font-semibold text-gray-700 mb-1" for="reg-email">Email</label>
                            <div class="flex items-center gap-2 border border-gray-200 rounded-xl px-3 bg-white focus-within:border-emerald-600 focus-within:ring-2 focus-within:ring-emerald-100 transition-all">
                                <span class="text-gray-400"><Icon Name="user" Size="Icon.IconSize.Small" /></span>
                                <InputText id="reg-email" type="email" class="flex-1 py-2 text-sm outline-none bg-transparent text-gray-900 placeholder-gray-300" @bind-Value="RegisterModel.Email" placeholder="you@example.com" />
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="block text-xs font-semibold text-gray-700 mb-1" for="reg-pw">Password</label>
                            <div class="flex items-center gap-2 border border-gray-200 rounded-xl px-3 bg-white focus-within:border-emerald-600 focus-within:ring-2 focus-within:ring-emerald-100 transition-all">
                                <span class="text-gray-400"><Icon Name="lock" Size="Icon.IconSize.Small" /></span>
                                <InputText id="reg-pw" type="@(ShowPassword ? "text" : "password")" class="flex-1 py-2 text-sm outline-none bg-transparent text-gray-900 placeholder-gray-300" @bind-Value="RegisterModel.Password" placeholder="Create a password" />
                                <button type="button" class="text-gray-400 hover:text-emerald-700 p-1" @onclick="@TogglePassword" aria-label="Toggle password visibility">
                                    <Icon Name="@(ShowPassword ? "eye-off" : "eye")" Size="Icon.IconSize.Small" />
                                </button>
                            </div>
                        </div>
                        <button type="submit" class="w-full py-2 bg-emerald-800 hover:bg-emerald-900 text-white rounded-xl font-bold text-sm shadow-md hover:shadow-lg transition-all active:scale-[0.99]">Create account</button>
                    </EditForm>
                }
            </div>
        </section>

        <!-- Right Panel: Decorative Art (hidden on mobile) -->
        <section class="bg-gradient-to-br from-green-50 to-emerald-100 hidden md:flex items-center justify-center p-8 relative overflow-hidden" aria-hidden="true">
            @if (!PasskeyVisible)
            {
                <img class="max-w-[80%] max-h-[80%] object-contain" src="svg/login.svg" alt="Login Banner" />
            }
            else
            {
                <img class="max-w-[80%] max-h-[80%] object-contain" src="svg/biometric.svg" alt="Biometric verification" />
            }
        </section>
    </div>
</div>

<Modal @ref="PasskeyModal" Title="@PasskeyModalTitle"
       Size="ModalSize.Medium" ShowSubmitButton="false" CancelText="Close"
       OnCancel="OnPasskeyCancel"
       @bind-Visible="PasskeyVisible">
    @if (PasskeyVisible)
    {
        @if (IsVerificationMode)
        {
            <!-- User HAS a passkey, needs to VERIFY it -->
            <PasskeyLoginPage UserId="@(LoggedInUserId > 0 ? LoggedInUserId : null)"
                              Email="@LoginModel.Email"
                              AutoStart="false"
                              OnCompleted="HandlePasskeyCompleted" />
        }
        else
        {
            <!-- User DOES NOT have a passkey, needs to SETUP/REGISTER it -->
            <PasskeySetupPage UserId="@LoggedInUserId"
                              Username="@LoggedInUsername"
                              OnCompleted="HandlePasskeyCompleted"
                              OnSkipped="HandlePasskeySkipped" />
        }
    }
</Modal>
