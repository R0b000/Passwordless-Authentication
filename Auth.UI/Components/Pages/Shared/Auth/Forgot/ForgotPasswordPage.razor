@page "/forgot-password"
@namespace Auth.UI.Components.Pages.Shared.Auth.Forgot
@using global::Shared.UI.Components.Toaster
@using global::Shared.UI.Components.Icons
@using global::Auth.UI.Manager.Interface.Auth
@using global::Auth.Model.Models.Auth

<PageTitle>Forgot password - Passwordless Auth</PageTitle>

<section class="lp-panel">
    <div class="lp-card">
        <h1 class="lp-title">Forgot your password?</h1>
        <p class="lp-sub">No worries. Enter your email and we'll send you a verification code.</p>

        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <div class="lp-alert @(Succeeded ? "lp-alert-success" : "lp-alert-danger")" role="alert">@StatusMessage</div>
        }

        @if (!Succeeded)
        {
            <div class="lp-field">
                <label class="lp-label" for="fp-email">Email address</label>
                <div class="lp-input">
                    <Icon Name="mail" Size="Icon.IconSize.Small" />
                    <InputText id="fp-email" type="email" class="lp-control" @bind-Value="RequestModel.Email" placeholder="name@example.com" />
                </div>
            </div>

            <Button Variant="Button.ButtonVariant.Primary" Block="true" OnClick="SubmitAsync" Disabled="@IsSubmitting">
                @if (IsSubmitting)
                {
                    <span class="ui-spinner" aria-hidden="true"></span>
                }
                Send verification code
            </Button>
        }
        else
        {
            <div class="lp-status">
                <div class="lp-status-text">Code sent!</div>
                <p class="lp-status-detail">If an account with that email exists, a verification code has been sent. Check your inbox and enter the code on the next page to reset your password.</p>
            </div>

            <div class="lp-btn lp-btn-primary" style="display:flex;justify-content:center;margin-top:1rem;">
                <a href="/reset-password?email=@Uri.EscapeDataString(RequestModel.Email)" class="ui-btn ui-btn-primary">Continue to reset</a>
            </div>
        }

        <div class="lp-divider"><span>or</span></div>
        <p class="text-center mb-0">Remembered it? <a href="/login">Sign in</a></p>
    </div>
</section>

<Toaster Position="ToastPosition.TopRight" />