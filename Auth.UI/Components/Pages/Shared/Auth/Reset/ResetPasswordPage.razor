@page "/reset-password"
@namespace Auth.UI.Components.Pages.Shared.Auth.Reset
@layout LoginLayout
@using global::Shared.UI.Components.Toaster
@using global::Shared.UI.Components.Icons
@using global::Auth.UI.Manager.Interface.Auth
@using global::Auth.Model.Models.Auth
@using Microsoft.AspNetCore.Components

<PageTitle>Reset password - Passwordless Auth</PageTitle>

<section class="lp-panel">
    <div class="lp-card">
        <h1 class="lp-title">Choose a new password</h1>
        <p class="lp-sub">Enter the verification code from your email and set a new password.</p>

        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <div class="lp-alert @(Succeeded ? "lp-alert-success" : "lp-alert-danger")" role="alert">@StatusMessage</div>
        }

        @if (!Succeeded)
        {
            <EditForm Model="@RequestModel" OnValidSubmit="SubmitAsync" FormName="resetPassword">
                <div class="lp-field">
                    <label class="lp-label" for="rp-email">Email</label>
                    <div class="lp-input">
                        <Icon Name="mail" Size="Icon.IconSize.Small" />
                        <InputText id="rp-email" type="email" class="lp-control" @bind-Value="RequestModel.Email" placeholder="name@example.com" />
                    </div>
                </div>

                <div class="lp-field">
                    <label class="lp-label" for="rp-otp">Verification code</label>
                    <div class="lp-input">
                        <Icon Name="key" Size="Icon.IconSize.Small" />
                        <InputText id="rp-otp" class="lp-control" @bind-Value="RequestModel.Otp" placeholder="123456" maxlength="6" />
                    </div>
                </div>

                <div class="lp-field">
                    <label class="lp-label" for="rp-pw">New password</label>
                    <div class="lp-input">
                        <Icon Name="lock" Size="Icon.IconSize.Small" />
                        <InputText id="rp-pw" type="@(ShowPassword ? "text" : "password")" class="lp-control" @bind-Value="RequestModel.NewPassword" placeholder="New password" />
                        <button type="button" class="lp-eye" @onclick="TogglePassword" aria-label="Toggle password visibility">
                            <Icon Name="@(ShowPassword ? "eye-off" : "eye")" Size="Icon.IconSize.Small" />
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(PasswordStrengthText))
                    {
                        <div class="lp-password-strength">
                            <div class="lp-strength-bar" style="width:@PasswordStrengthPercent%"></div>
                            <span class="lp-strength-text">@PasswordStrengthText</span>
                        </div>
                    }
                </div>

                <div class="lp-field">
                    <label class="lp-label" for="rp-pwc">Confirm new password</label>
                    <div class="lp-input">
                        <Icon Name="lock" Size="Icon.IconSize.Small" />
                        <InputText id="rp-pwc" type="@(ShowPassword ? "text" : "password")" class="lp-control" @bind-Value="RequestModel.ConfirmPassword" placeholder="Repeat password" />
                    </div>
                </div>

                <Button Variant="Button.ButtonVariant.Primary" Block="true" Type="submit" Disabled="@IsSubmitting">
                    @if (IsSubmitting)
                    {
                        <span class="ui-spinner" aria-hidden="true"></span>
                    }
                    Reset password
                </Button>
            </EditForm>
        }
        else
        {
            <div class="lp-status">
                <div class="lp-status-text">Password reset successful!</div>
                <p class="lp-status-detail">Your password has been updated. You can now sign in with your new password.</p>
            </div>

            <div class="lp-btn lp-btn-primary" style="display:flex;justify-content:center;margin-top:1rem;">
                <a href="/login" class="ui-btn ui-btn-primary">Sign in</a>
            </div>
        }

        <div class="lp-divider"><span>or</span></div>
        <p class="text-center mb-0">Back to <a href="/login">Sign in</a></p>
    </div>
</section>

<Toaster Position="ToastPosition.TopRight" />