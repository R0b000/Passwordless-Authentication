@namespace Auth.UI.Components.Pages.Shared.Auth.Passkey
@using global::Shared.UI.Components.Icons

<div class="text-center p-2">
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="p-3 mb-4 rounded-xl text-xs bg-red-50 text-red-700 text-left border border-red-100" role="alert">@StatusMessage</div>
    }

    @if (State == PasskeyState.Idle)
    {
        @if (IsStepUp)
        {
            <div class="flex flex-col items-center mb-5">
                <div class="w-14 h-14 rounded-full border-2 border-emerald-100 inline-flex items-center justify-center text-emerald-700 bg-emerald-50 mb-2">
                    <Icon Name="fingerprint" Size="Icon.IconSize.Large" />
                </div>
                <h2 class="text-base font-bold text-emerald-950 mb-0.5">Verify it's you</h2>
                <p class="text-xs text-gray-500 max-w-[280px] mx-auto">Your password was accepted. Complete sign-in with your passkey or security key.</p>
            </div>

            <button class="w-full py-2 bg-emerald-800 hover:bg-emerald-900 text-white rounded-xl font-bold text-sm shadow-md hover:shadow-lg transition-all active:scale-[0.99] flex items-center justify-center gap-2" @onclick="@(() => StartAssertionAsync())" type="button">
                <Icon Name="fingerprint" Size="Icon.IconSize.Small" />
                Continue with passkey
            </button>

            <div class="flex flex-col gap-2 mt-3">
                <button class="inline-flex items-center justify-center gap-2 w-full py-2 border border-gray-200 rounded-xl bg-white hover:border-emerald-600 transition-colors text-xs font-semibold text-emerald-850" @onclick="@(() => StartAssertionAsync("cross-platform"))" type="button">
                    <Icon Name="usb" Size="Icon.IconSize.Small" /> Use a security key
                </button>
                @if (!OtpRequested)
                {
                    <button class="inline-flex items-center justify-center gap-2 w-full py-2 border border-gray-200 rounded-xl bg-white hover:border-emerald-600 transition-colors text-xs font-semibold text-emerald-850" @onclick="@RequestOtpAsync" type="button">Email me a code</button>
                }
                else
                {
                    <button class="inline-flex items-center justify-center gap-2 w-full py-2 border border-gray-200 rounded-xl bg-white hover:border-emerald-600 transition-colors text-xs font-semibold text-emerald-850" @onclick="@HideOtp" type="button">Hide code entry</button>
                }
            </div>

            @if (OtpRequested)
            {
                <div class="mt-4 text-left">
                    <label class="block text-xs font-semibold text-gray-700 mb-1" for="pk-otp">Enter the 6-digit code sent to your email:</label>
                    <div class="flex items-center gap-2 border border-gray-200 rounded-xl px-3 bg-white focus-within:border-emerald-600 focus-within:ring-2 focus-within:ring-emerald-100 transition-all mb-2">
                        <span class="text-gray-400"><Icon Name="lock" Size="Icon.IconSize.Small" /></span>
                        <input id="pk-otp" class="flex-1 py-1.5 text-sm outline-none bg-transparent text-gray-900 placeholder-gray-300" @bind="OtpCode" placeholder="6-digit code" />
                    </div>
                    <button class="w-full py-2 bg-emerald-850 hover:bg-emerald-950 text-white rounded-xl font-bold text-xs shadow-md transition-all" @onclick="@VerifyOtpAsync" type="button">Verify code &amp; sign in</button>
                </div>
            }
        }
        else if (!IsEmailResolved)
        {
            <div class="flex flex-col items-center mb-5">
                <div class="w-14 h-14 rounded-full border-2 border-emerald-100 inline-flex items-center justify-center text-emerald-700 bg-emerald-50 mb-2">
                    <Icon Name="fingerprint" Size="Icon.IconSize.Large" />
                </div>
                <h2 class="text-base font-bold text-emerald-950 mb-0.5">Sign in with a passkey</h2>
                <p class="text-xs text-gray-500 max-w-[280px] mx-auto">Use your device biometric or a security key — no password needed.</p>
            </div>

            <div class="text-left mb-4">
                <label class="block text-xs font-semibold text-gray-700 mb-1" for="pk-email">Email address</label>
                <div class="flex items-center gap-2 border border-gray-200 rounded-xl px-3 bg-white focus-within:border-emerald-600 focus-within:ring-2 focus-within:ring-emerald-100 transition-all">
                    <span class="text-gray-400"><Icon Name="user" Size="Icon.IconSize.Small" /></span>
                    <input id="pk-email" class="flex-1 py-1.5 text-sm outline-none bg-transparent text-gray-900 placeholder-gray-300" type="email" @bind="Email" placeholder="you@example.com" />
                </div>
                <div class="text-[10px] text-gray-400 mt-1">Enter the email address linked to your account.</div>
            </div>

            <button class="w-full py-2 bg-emerald-800 hover:bg-emerald-900 text-white rounded-xl font-bold text-sm shadow-md hover:shadow-lg transition-all active:scale-[0.99]" @onclick="@ResolveAccountAsync" type="button">
                @(IsResolving ? "Resolving…" : "Continue")
            </button>
        }
        else
        {
            <div class="flex flex-col items-center mb-5">
                <div class="w-14 h-14 rounded-full border-2 border-emerald-100 inline-flex items-center justify-center text-emerald-700 bg-emerald-50 mb-2">
                    <Icon Name="fingerprint" Size="Icon.IconSize.Large" />
                </div>
                <h2 class="text-base font-bold text-emerald-950 mb-0.5">Choose your method</h2>
                <p class="text-xs text-gray-500 max-w-[280px] mx-auto">Verify your identity to complete sign-in.</p>
            </div>

            <div class="flex items-center justify-between gap-3 text-left p-3 border border-gray-100 rounded-xl bg-gray-50 mb-4 text-xs">
                <div>
                    <div class="text-[10px] text-gray-400">Signing in as</div>
                    <strong>@ResolvedUsername</strong> <span class="text-gray-400">(@Email)</span>
                </div>
                @if (UserId == null)
                {
                    <button class="border-none bg-transparent text-emerald-700 font-semibold text-xs hover:underline cursor-pointer" @onclick="@ResetEmailLookup" type="button">Change</button>
                }
            </div>

            <button class="w-full py-2 bg-emerald-800 hover:bg-emerald-900 text-white rounded-xl font-bold text-sm shadow-md hover:shadow-lg transition-all active:scale-[0.99] flex items-center justify-center gap-2" @onclick="@(() => StartAssertionAsync())" type="button">
                <Icon Name="fingerprint" Size="Icon.IconSize.Small" />
                Sign in with a passkey
            </button>

            <div class="flex flex-col gap-2 mt-3">
                <button class="inline-flex items-center justify-center gap-2 w-full py-2 border border-gray-200 rounded-xl bg-white hover:border-emerald-600 transition-colors text-xs font-semibold text-emerald-850" @onclick="@(() => StartAssertionAsync("cross-platform"))" type="button">
                    <Icon Name="usb" Size="Icon.IconSize.Small" /> Use a security key
                </button>
                @if (UserId == null)
                {
                    <button class="inline-flex items-center justify-center gap-2 w-full py-2 border border-gray-200 rounded-xl bg-white hover:border-emerald-600 transition-colors text-xs font-semibold text-emerald-850" @onclick="@ResetEmailLookup" type="button">Use a different email</button>
                }
            </div>
        }
    }
    else
    {
        <div class="flex flex-col items-center mb-5">
            <div class="w-14 h-14 rounded-full border-2 border-emerald-100 inline-flex items-center justify-center text-emerald-700 bg-emerald-50 mb-2">
                <Icon Name="@(State == PasskeyState.Success ? "check" : State == PasskeyState.Error ? "alert-triangle" : "fingerprint")"
                      Size="Icon.IconSize.Large" />
            </div>
            <h2 class="text-base font-bold text-emerald-950 mb-0.5">
                @(State == PasskeyState.Success ? "Signed in"
                    : State == PasskeyState.Error ? "Couldn't sign in"
                    : "Verify it's you")
            </h2>
            <p class="text-xs text-gray-500 max-w-[280px] mx-auto">@StatusDetail</p>
        </div>

        @if (State == PasskeyState.Error)
        {
            <div class="flex flex-col gap-2">
                <button class="w-full py-2 bg-emerald-800 hover:bg-emerald-900 text-white rounded-xl font-bold text-sm shadow-md hover:shadow-lg transition-all active:scale-[0.99] flex items-center justify-center gap-2" @onclick="@(() => StartAssertionAsync())" type="button">
                    <Icon Name="fingerprint" Size="Icon.IconSize.Small" /> Try again
                </button>
                <button class="inline-flex items-center justify-center gap-2 w-full py-2 border border-gray-200 rounded-xl bg-white hover:border-emerald-600 transition-colors text-xs font-semibold text-emerald-850" @onclick="@(() => StartAssertionAsync("cross-platform"))" type="button">
                    <Icon Name="usb" Size="Icon.IconSize.Small" /> Use a security key
                </button>
            </div>
        }
    }
</div>
