@page "/profile"
@page "/account/profile"

@namespace Auth.UI.Components.Pages.Customer.Account.Profile
@layout MainLayout
@using static Microsoft.AspNetCore.Components.Web.RenderMode

@using global::Shared.UI.Components.Toaster
@using global::Shared.UI.Components.Upload
@using global::Shared.UI.Components.Tag

<PageTitle>Profile - Passwordless Auth</PageTitle>

<div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 md:p-8">
    <div class="flex justify-between items-start flex-wrap gap-4 mb-8">
        <div>
            <h3 class="text-2xl font-extrabold text-gray-900 mb-1 tracking-tight">Profile</h3>
            <div class="text-sm text-gray-500">Manage your personal information and account overview.</div>
        </div>
        @if (!EditMode)
        {
            <div class="flex gap-3 flex-wrap">
                <Button Variant="Button.ButtonVariant.Primary" IconName="edit" OnClick="EnterEdit">Edit profile</Button>
                <Button Variant="Button.ButtonVariant.Danger" Outline="true" IconName="x" OnClick="Logout">Log out</Button>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="p-4 mb-6 text-sm rounded-xl @(Succeeded ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-red-50 text-red-700 border border-red-200")" role="alert">
            @StatusMessage
        </div>
    }

    <div class="flex items-center gap-6 p-6 mb-8 bg-gray-50/50 border border-gray-100 rounded-2xl">
        <div class="w-20 h-20 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center text-2xl font-bold shadow-inner flex-shrink-0">@Initials</div>
        <div>
            <div class="text-gray-900 font-semibold mb-1">Profile picture</div>
            <div class="text-gray-500 text-xs mb-3">JPG or PNG, up to 5 MB.</div>
            @if (EditMode)
            {
                <Upload Accept="image/*" MaxSize="5242880" OnFileSelected="OnAvatarSelected" />
            }
        </div>
    </div>

    @if (EditMode)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1.5">Display name</label>
                <input class="w-full px-4 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-100 focus:border-emerald-500 outline-none transition-all text-sm text-gray-900" @bind="Model!.DisplayName" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1.5">Username</label>
                <input class="w-full px-4 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-100 focus:border-emerald-500 outline-none transition-all text-sm text-gray-900 bg-gray-50" readonly @bind="Model!.Username" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1.5">Email</label>
                <input class="w-full px-4 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-100 focus:border-emerald-500 outline-none transition-all text-sm text-gray-900" type="email" @bind="Model!.Email" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1.5">Phone</label>
                <input class="w-full px-4 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-100 focus:border-emerald-500 outline-none transition-all text-sm text-gray-900" @bind="Model!.Phone" />
            </div>
            <div class="md:col-span-2">
                <label class="block text-xs font-semibold text-gray-700 mb-1.5">Bio</label>
                <textarea class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-100 focus:border-emerald-500 outline-none transition-all text-sm text-gray-900" rows="3" @bind="Model!.Bio"></textarea>
            </div>
        </div>
        <div class="flex items-center gap-3 pt-6 border-t border-gray-100">
            <Button Variant="Button.ButtonVariant.Primary" OnClick="SaveAsync">Save changes</Button>
            <Button Variant="Button.ButtonVariant.Secondary" Outline="true" OnClick="CancelEdit">Cancel</Button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-y-8 gap-x-6 pt-2">
            <div><div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Display name</div><div class="text-sm font-medium text-gray-900">@Model?.DisplayName</div></div>
            <div><div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Username</div><div class="text-sm font-medium text-gray-900">@Model?.Username</div></div>
            <div><div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Email</div><div class="text-sm font-medium text-gray-900">@Model?.Email</div></div>
            <div><div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Phone</div><div class="text-sm font-medium text-gray-900">@(string.IsNullOrEmpty(Model?.Phone) ? "—" : Model?.Phone)</div></div>
            <div class="sm:col-span-2 lg:col-span-2"><div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Bio</div><div class="text-sm text-gray-700 leading-relaxed">@(string.IsNullOrEmpty(Model?.Bio) ? "No bio provided." : Model?.Bio)</div></div>
            
            <div class="col-span-full h-px bg-gray-100 my-2"></div>
            
            <div><div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Date joined</div><div class="text-sm font-medium text-gray-900">@Model?.DateJoined.ToString("MMM d, yyyy")</div></div>
            <div><div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Last active</div><div class="text-sm font-medium text-gray-900">@Model?.LastActive.ToString("MMM d, yyyy h:mm tt")</div></div>
            <div><div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Last login</div><div class="text-sm font-medium text-gray-900">@(Model?.LastLoginAt?.ToString("MMM d, yyyy h:mm tt") ?? "—")</div></div>
            <div><div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Last login IP</div><div class="text-sm font-medium text-gray-900">@(Model?.LastLoginIp ?? "—")</div></div>
            <div>
                <div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Account status</div>
                <div>
                    <Tag Variant="@(Model?.AccountStatus == "active" ? Tag.TagVariant.Success : Tag.TagVariant.Danger)">@Model?.AccountStatus</Tag>
                </div>
            </div>
        </div>
    }
</div>

<Modal Title="Confirm Logout" SubmitText="Log out" SubmitIcon="log-out"
       OnSubmit="ConfirmLogout" @bind-Visible="LogoutModalVisible">
    <p>Are you sure you want to log out of your account?</p>
</Modal>
