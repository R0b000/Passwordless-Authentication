@namespace Shared.UI.Components.Modal

@if (Visible)
{
    <div class="fixed inset-0 bg-black/45 flex items-start justify-center p-4 md:p-[4vh] z-[1050] overflow-y-auto" @onclick="OverlayClick" role="presentation">
        <div class="bg-white rounded-2xl shadow-2xl w-full flex flex-col transition-all my-auto @SizeClass" role="dialog" aria-modal="true" @onclick:stopPropagation>
            <div class="flex items-center justify-between p-4 border-b border-gray-100">
                <h5 class="text-base font-bold text-emerald-950">@Title</h5>
                <button type="button" class="p-1 rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-900 transition-colors" aria-label="Close" @onclick="CancelAsync">
                    <Icon Name="x" Size="Icon.IconSize.Small" />
                </button>
            </div>
            <div class="p-5 overflow-y-auto text-sm">
                @ChildContent
            </div>
            <div class="flex justify-end gap-2 p-4 border-t border-gray-100">
                <Button Variant="Button.ButtonVariant.Secondary" OnClick="CancelAsync">@CancelText</Button>
                @if (ShowSubmitButton)
                {
                    <Button Variant="Button.ButtonVariant.Primary" IconName="@SubmitIcon"
                            Disabled="@IsSubmitting" OnClick="SubmitAsync">
                        @if (IsSubmitting)
                        {
                            <span class="w-3.5 h-3.5 border-2 border-white/50 border-t-white rounded-full inline-block animate-spin" aria-hidden="true"></span>
                        }
                        @SubmitText
                    </Button>
                }
            </div>
        </div>
    </div>
}

@code {
    private string SizeClass => Size switch
    {
        ModalSize.Small => "max-w-xs",
        ModalSize.Large => "max-w-3xl",
        ModalSize.ExtraLarge => "max-w-5xl",
        _ => "max-w-lg" // Default is Medium
    };
}
