@namespace Shared.UI.Components.Drawer

@if (Visible)
{
    <div class="fixed inset-0 bg-black/35 z-[1050]" @onclick="Close"></div>
    <div class="fixed top-0 bottom-0 w-[320px] max-w-[85vw] bg-white shadow-2xl z-[1051] flex flex-col border-gray-150 @PlacementClass" @onclick:stopPropagation>
        <div class="flex items-center justify-between p-4 border-b border-gray-100">
            <h5 class="text-base font-semibold text-gray-900">@Title</h5>
            <button class="p-1 rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-900 transition-colors" @onclick="Close" aria-label="Close">
                <Icon Name="x" Size="Icon.IconSize.Small" />
            </button>
        </div>
        <div class="p-4 overflow-y-auto flex-1 text-sm">
            @ChildContent
        </div>
        @if (Footer is not null)
        {
            <div class="p-4 border-t border-gray-100 flex gap-2 justify-end bg-gray-50">
                @Footer
            </div>
        }
    </div>
}

@code {
    private string PlacementClass => Placement switch
    {
        DrawerPlacement.Left => "left-0 border-r",
        _ => "right-0 border-l"
    };
}
