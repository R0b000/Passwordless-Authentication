@namespace Shared.UI.Components.Collapse

<div class="border border-gray-200 rounded-2xl overflow-hidden bg-white">
    @foreach (var item in Items)
    {
        var isOpen = ActiveKeys.Contains(item.Key);
        <div class="border-b border-gray-200 last:border-b-0">
            <button class="w-full text-left bg-white border-none py-3.5 px-4 text-sm font-medium cursor-pointer flex items-center justify-between gap-2 hover:bg-gray-50 transition-colors" @onclick="() => Toggle(item.Key)">
                <span>@item.Title</span>
                <span class="transition-transform duration-200 @(isOpen ? "rotate-180" : "")">
                    <Icon Name="chevron-down" Size="Icon.IconSize.Small" />
                </span>
            </button>
            <div class="overflow-hidden transition-all duration-250 @(isOpen ? "py-3 px-4 border-t border-gray-100 max-h-[500px]" : "max-h-0")">
                @item.Content
            </div>
        </div>
    }
</div>
