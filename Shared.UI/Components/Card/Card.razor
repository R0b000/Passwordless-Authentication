@namespace Shared.UI.Components.Card

<div class="bg-white border border-gray-200 rounded-2xl shadow-sm flex flex-col overflow-hidden">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img class="w-full object-cover" src="@ImageUrl" alt="@ImageAlt" />
    }
    <div class="p-5 flex-1">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <h5 class="text-base font-semibold text-gray-900 mb-2">@Title</h5>
        }
        @if (!string.IsNullOrWhiteSpace(Text))
        {
            <p class="text-sm text-gray-500 mb-0">@Text</p>
        }
        @ChildContent
    </div>
    @if (Footer is not null)
    {
        <div class="p-4 border-t border-gray-150 flex gap-2 items-center bg-gray-50">
            @Footer
        </div>
    }
</div>
