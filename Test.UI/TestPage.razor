@page "/test"
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@using Test
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div>
    <button class="btn" @onclick="@handleDownloadClick">Download PDF</button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.2/html2pdf.bundle.min.js"></script>
<script src="_content/Test.UI/test.js"></script>

@code {
    private async Task handleDownloadClick()
    {
        try
        {
            await JS.InvokeVoidAsync("downloadHtmlAsPdf", HtmlCode.Source, "novapulse.pdf");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"JS Interop Error: {ex.Message}");
        }
    }
}